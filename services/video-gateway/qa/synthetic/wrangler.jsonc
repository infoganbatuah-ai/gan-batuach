  },
  "migrations": [{ "tag": "synthetic-qa-v1", "new_sqlite_classes": ["SyntheticQaSession"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "do-p44-synthetic-qa-20261023" }]
