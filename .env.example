NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-only-for-server-admin-routes
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SANDBOX_MODE=false
CRON_SECRET=replace-with-long-random-secret
AI_OBSERVER_SECRET=replace-with-long-random-secret
VIDEO_GATEWAY_URL=https://video.your-domain.co.il
VIDEO_GATEWAY_SIGNING_SECRET=replace-with-long-random-secret
FIELD_ENCRYPTION_KEY=replace-with-32-byte-random-secret

# Seed test user passwords. Set in .env.local only; do not commit real production passwords.
SEED_ADMIN_PASSWORD=replace-with-local-password
SEED_INSPECTOR_PASSWORD=replace-with-local-password
SEED_MANAGER_PASSWORD=replace-with-local-password
SEED_PARENT_PASSWORD=replace-with-local-password
SEED_STAFF_PASSWORD=replace-with-local-password

# Required for live AI observer analysis. Without it, AI configuration is pending.
AI_GATEWAY_URL=https://ai.your-domain.co.il

# Optional future AI assistant provider. If missing, the in-app assistant works in rule-based mode from Supabase data.
OPENAI_API_KEY=
AI_PROVIDER_API_KEY=

# SUPABASE_SERVICE_ROLE_KEY is required in Vercel for admin provisioning and lead conversion. Never expose it publicly.
