# Gan Batuach environment template
# Copy to .env.local for local development or .env.production.local for Docker.
# Never commit real secret values.

# REQUIRED, PUBLIC: Supabase project URL used by browser and server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# REQUIRED, PUBLIC: Supabase publishable/anon key used by browser and server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# REQUIRED, SERVER-ONLY: Supabase service role key for admin provisioning, lead conversion, secure storage uploads and server-side data access.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# REQUIRED, PUBLIC: canonical app URL for redirects and links.
NEXT_PUBLIC_APP_URL=https://app.your-domain.co.il

# REQUIRED, SERVER-ONLY: same canonical app URL for server-side jobs and health tooling.
APP_URL=https://app.your-domain.co.il

# REQUIRED, SERVER-ONLY: Supabase auth redirect URL configured in Supabase dashboard.
AUTH_REDIRECT_URL=https://app.your-domain.co.il/auth/callback

# REQUIRED FOR MOBILE BUILDS, BUILD-TIME: URL loaded by Capacitor native shell.
CAPACITOR_SERVER_URL=https://app.your-domain.co.il

# REQUIRED, SERVER-ONLY: protects scheduled cron routes.
CRON_SECRET=replace-with-long-random-secret

# REQUIRED, SERVER-ONLY: protects deep infrastructure health checks.
HEALTHCHECK_SECRET=replace-with-long-random-secret

# REQUIRED, SERVER-ONLY: field encryption for camera/device secrets. Do not rotate without a migration plan.
FIELD_ENCRYPTION_KEY=replace-with-32-byte-random-secret

# OPTIONAL, PUBLIC: enable sandbox-only UI diagnostics. Must be false in production.
NEXT_PUBLIC_SANDBOX_MODE=false

# OPTIONAL, SERVER-ONLY: real video gateway for RTSP/ONVIF/DVR/NVR to browser-safe playback.
VIDEO_GATEWAY_URL=https://video.your-domain.co.il

# OPTIONAL, SERVER-ONLY: video gateway provider and API key for MediaMTX/go2rtc/custom gateway.
VIDEO_GATEWAY_PROVIDER=custom
VIDEO_GATEWAY_API_KEY=

# OPTIONAL, SERVER-ONLY: shared secret for video gateway callbacks and health checks.
VIDEO_GATEWAY_SIGNING_SECRET=replace-with-long-random-secret

# OPTIONAL, SERVER-ONLY: communication provider mode. Default mock mode writes logs only and sends no real messages.
COMMUNICATION_PROVIDER=mock
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=
SMS_PROVIDER_ACCOUNT_ID=
SMS_REAL_SEND_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REAL_SEND_ENABLED=false
EMAIL_PROVIDER=
EMAIL_API_KEY=

# OPTIONAL, SERVER-ONLY except VAPID_PUBLIC_KEY if exposed through a dedicated client config endpoint later.
# Push defaults to mock mode and sends no real Web/Android/iOS push without provider setup.
PUSH_PROVIDER=mock
PUSH_REAL_SEND_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_PROVIDER_ENDPOINT=
PUSH_PROVIDER_API_KEY=

# OPTIONAL, SERVER-ONLY: real AI/smart observer gateway. If missing, the app uses deterministic rule-based insights.
AI_GATEWAY_URL=https://ai.your-domain.co.il

# OPTIONAL, SERVER-ONLY: protects AI observer ingestion route.
AI_OBSERVER_SECRET=replace-with-long-random-secret

# OPTIONAL, SERVER-ONLY: local vision detector mode. Default is safe shadow mock. Future values: local_opencv, local_yolo, local_http.
LOCAL_VISION_PROVIDER=local_mock

# OPTIONAL, SERVER-ONLY: external AI provider keys. Leave empty to avoid external AI calls.
OPENAI_API_KEY=
AI_PROVIDER_API_KEY=

# OPTIONAL, SERVER-ONLY: passkey relying party overrides.
PASSKEY_RP_NAME=גן בטוח
PASSKEY_RP_ID=your-domain.co.il
PASSKEY_ORIGIN=https://app.your-domain.co.il

# OPTIONAL, SERVER-ONLY: demo seeding only. Never set production user passwords here.
DEMO_BATCH_ID=
SEED_ADMIN_PASSWORD=
SEED_INSPECTOR_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_PARENT_PASSWORD=
SEED_STAFF_PASSWORD=

# REQUIRED SUPABASE STORAGE BUCKETS
# Create as private buckets unless explicitly documented otherwise:
# - profile-photos
# - child-photos
# - pickup-person-photos
# - kindergarten-logos
# - documents
# - camera-snapshots
