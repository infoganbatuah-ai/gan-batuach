{
  "version": "digital-observer-ci-v1",
  "nodeVersion": "22",
  "canonicalLintPaths": [
    "lib/api.ts",
    "lib/domain/digital-observer/incident-correlation.ts",
    "lib/domain/digital-observer/incident-verification-engine.ts",
    "lib/domain/digital-observer/incident-verification-service.ts",
    "lib/domain/digital-observer/risk-decision-engine.ts",
    "lib/domain/digital-observer/risk-decision-service.ts",
    "lib/domain/digital-observer/feedback-calibration.ts",
    "lib/domain/digital-observer/watch-rule-compiler.ts",
    "lib/domain/digital-observer/watch-rule-service.ts",
    "lib/domain/digital-observer/investigation-query.ts",
    "lib/domain/digital-observer/investigation-results.ts",
    "lib/domain/digital-observer/investigation-search-service.ts",
    "lib/domain/digital-observer/learning-engine.ts",
    "lib/domain/digital-observer/observation-provenance.ts",
    "app/api/digital-observer/incidents/route.ts",
    "app/api/digital-observer/incidents/feedback/route.ts",
    "app/api/digital-observer/investigation/route.ts",
    "app/api/digital-observer/watch-rules/route.ts",
    "app/api/digital-observer/events/review/route.ts",
    "app/api/digital-observer/event-clips/[id]/media/route.ts"
  ],
  "domain": [
    { "name": "event-journal", "args": ["scripts/qa/check-event-journal.mjs"] },
    { "name": "event-ingest", "args": ["scripts/qa/check-event-ingest.mjs"] },
    { "name": "event-outbox", "args": ["scripts/qa/check-event-outbox.mjs"] },
    { "name": "object-inference", "args": ["scripts/qa/check-object-inference.mjs"] },
    { "name": "event-media", "args": ["scripts/qa/check-digital-observer-event-media.mjs"] },
    { "name": "evidence-compatibility", "args": ["scripts/qa/check-event-evidence-compatibility.mjs"] },
    { "name": "tracking-configuration", "args": ["scripts/qa/check-event-tracker-configuration.mjs"] },
    { "name": "spatial-geometry", "args": ["scripts/qa/check-spatial-entry-geometry.mjs"] },
    { "name": "journal-owner-lock", "args": ["scripts/qa/check-journal-owner-lock.mjs"] },
    { "name": "real-style-event-bridge", "args": ["scripts/qa/check-real-detection-event-bridge.mjs"] },
    { "name": "real-source-isolation", "args": ["scripts/qa/check-product-observer-real-source.mjs"] },
    { "name": "incidents", "args": ["scripts/qa/check-digital-observer-incidents.mjs"] },
    { "name": "context-baseline", "args": ["scripts/qa/check-real-event-context-baseline.mjs"] },
    { "name": "risk-decision", "args": ["scripts/qa/check-digital-observer-risk-decision.mjs"] },
    { "name": "verification", "args": ["scripts/qa/check-digital-observer-incident-verification.mjs"] },
    { "name": "feedback-calibration", "args": ["scripts/qa/check-digital-observer-feedback-calibration.mjs"] },
    { "name": "watch-rules", "args": ["scripts/qa/check-digital-observer-watch-rule-compiler.mjs"] },
    { "name": "investigation", "args": ["--test", "scripts/qa/check-digital-observer-investigation.mjs"] }
  ],
  "security": [
    { "name": "environment-safety", "args": ["scripts/validate-environment-safety.mjs"] },
    { "name": "encryption-separation", "args": ["scripts/qa/check-encryption-key-separation.mjs"] },
    { "name": "storage-policy", "args": ["scripts/qa/check-storage-policy-safety.mjs"] },
    { "name": "observer-engine-separation", "args": ["scripts/qa/check-observer-engine-separation.mjs"] },
    { "name": "canonical-api-error-boundary", "args": ["scripts/qa/check-canonical-api-error-boundary.mjs"] },
    { "name": "tenant-privacy-boundary", "args": ["--test", "scripts/qa/digital-guard-tenant-boundary.test.mjs"] },
    { "name": "mock-shadow-isolation", "args": ["scripts/qa/check-product-observer-real-source.mjs"] }
  ]
}
