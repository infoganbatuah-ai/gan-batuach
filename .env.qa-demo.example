# QA demo credentials example only. Copy values to an ignored local file such as .env.qa-demo.local.
# Do not commit real passwords. Do not use real users or real child/parent data.

QA_DEMO_USER_SETUP_CONFIRM=I_UNDERSTAND_SYNTHETIC_DEMO_ONLY
QA_DEMO_ENVIRONMENT=demo

# Required for the optional server-side setup script only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Provide passwords locally only for accounts you want the script to create/update.
QA_DEMO_PARENT_PASSWORD=
QA_DEMO_MANAGER_PASSWORD=
QA_DEMO_STAFF_ASSIGNED_PASSWORD=
QA_DEMO_STAFF_UNASSIGNED_PASSWORD=
QA_DEMO_INSPECTOR_ASSIGNED_PASSWORD=
QA_DEMO_INSPECTOR_UNASSIGNED_PASSWORD=
QA_DEMO_ADMIN_PASSWORD=
QA_DEMO_DIGITAL_OBSERVER_PASSWORD=

# Optional email overrides. Defaults are documented in DEMO_AUTH_SETUP_1 reports.
QA_DEMO_PARENT_EMAIL=
QA_DEMO_MANAGER_EMAIL=
QA_DEMO_STAFF_ASSIGNED_EMAIL=
QA_DEMO_STAFF_UNASSIGNED_EMAIL=
QA_DEMO_INSPECTOR_ASSIGNED_EMAIL=
QA_DEMO_INSPECTOR_UNASSIGNED_EMAIL=
QA_DEMO_ADMIN_EMAIL=
QA_DEMO_DIGITAL_OBSERVER_EMAIL=
