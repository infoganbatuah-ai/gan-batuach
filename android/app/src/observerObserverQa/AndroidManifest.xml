<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Offline Observer QA has no FCM identity. Keep the shared Push library for
         future qualified variants, but remove its manifest entry points here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />
    <application>
        <activity android:name="com.ganbatuach.app.MainActivity">
            <!-- Replace the shared scheme-wide VIEW filter only in Observer QA.
                 Gan's merged manifest retains its existing filter unchanged. -->
            <intent-filter tools:node="removeAll" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="observerqaandroid" android:host="camera" />
                <data android:scheme="observerqaandroid" android:host="event" />
                <data android:scheme="observerqaandroid" android:host="incident" />
                <data android:scheme="observerqaandroid" android:host="evidence" />
                <data android:scheme="observerqaandroid" android:host="investigation" />
                <data android:scheme="observerqaandroid" android:host="notification" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="observerqaandroid" android:host="return"
                    android:path="/qa/device-proof" />
            </intent-filter>
        </activity>
        <service android:name="com.capacitorjs.plugins.pushnotifications.MessagingService" tools:node="remove" />
        <receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver" tools:node="remove" />
        <service android:name="com.google.firebase.messaging.FirebaseMessagingService" tools:node="remove" />
        <service android:name="com.google.firebase.components.ComponentDiscoveryService" tools:node="remove" />
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" />
    </application>
</manifest>
