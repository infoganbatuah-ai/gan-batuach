{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon.ico|assets|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon.ico|assets|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)"
        }
      ]
    },
    "/api/digital-observer/integration/v1/sites/[id]/status": {},
    "/api/passkeys/authenticate/options": {},
    "/api/passkeys/authenticate/verify": {},
    "/api/passkeys/register/options": {},
    "/api/passkeys/register/verify": {}
  }
}