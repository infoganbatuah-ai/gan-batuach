{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/register/layout,_N_T_/app/register/page,_N_T_/app/register"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/register/__PAGE__",
    "/app/register",
    "/app",
    "/_index",
    "/_head"
  ]
}