# Static manifest. Number = top-level statement in the corresponding guarded fragment.
# SQL after AS <body> and DO blocks are pinned in full by the file hash.
INSTALL existing-catalog.sql -> base-bootstrap.sql -> atomic.sql -> ownership-window-open.sql -> writer.sql -> ownership-window-close.sql -> generic-execute.sql -> writer-policies.sql -> ownership-window-open.sql -> pair-forward.sql -> ownership-window-close.sql -> boundary-check.sql
WITHDRAW withdrawal-gate.sql -> boundary-check.sql -> installed-original-surface -> installed-catalog.sql -> membership-close.sql -> pair-rollback.sql -> writer-policies-rollback.sql -> base-withdraw.sql -> existing-catalog.sql

existing-catalog.sql  sha256=648d1878b310715486af86b477cea3bbc323ca9a21cbc610dc473dc098f62c2b
